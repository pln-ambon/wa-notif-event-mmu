# app port
PORT=

# db config
DB_SERVER=
DB_PASSWORD=
DB_USER=
DB_NAME=
DB_PORT=

# wablas config
WABLAS_URL=<url_wablas>
WABLAS_TOKEN=<token_wablas>

# wa group id per origin (wajib diisi jika WA_TESTING bukan true)
WA_GROUP_ID_TERNATE=<wa_group_id_ternate>
WA_GROUP_ID_SOFIFI=<wa_group_id_sofifi>
WA_GROUP_ID_TUAL=<wa_group_id_tual>

# private number untuk pesan eskalasi (62821xxx)
WA_PRIVATE_ID=<wa_private_id>
# private number eskalasi 8 jam pemadaman/manuver (kosong = pakai WA_PRIVATE_ID)
WA_PRIVATE_ID_8H=

# testing: true = SEMUA pesan dikirim ke WA_PRIVATE_TESTING_ID (private), bukan ke group
WA_TESTING=false
WA_PRIVATE_TESTING_ID=<wa_private_testing_id>
